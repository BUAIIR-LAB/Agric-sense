# Copy to .env and adjust for local development.
# For EAS builds, set these in eas.json per profile or as EAS Secrets.

# Main REST API (auth, diagnosis, spectroscopy, history)
EXPO_PUBLIC_API_URL=http://147.93.116.6:8090

# Chat / voice assistant API
EXPO_PUBLIC_CHAT_API_URL=https://your-chat-api.example.com

# Dev-only: use production API while in __DEV__ (default: true)
# EXPO_PUBLIC_USE_PRODUCTION=false

# Dev-only: local backend on a physical device
# EXPO_PUBLIC_USE_PHYSICAL_DEVICE=true
# EXPO_PUBLIC_PHYSICAL_DEVICE_IP=10.10.162.85
